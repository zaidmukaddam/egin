---
// The "Ask AI" drawer: a panel docked to the right that answers questions from the docs (/api/ask). On wide
// screens it pushes the page over instead of covering it; on narrow ones it is a full-screen sheet. Its
// expand button makes it cover the window, with the conversation in one centred column.
// Opened by any [data-ask-open] button or ⌘I / Ctrl+I, closed by the same keys, its close button or Esc.
import { getCollection } from "astro:content";

// Page titles by URL, so the drawer can name the page being asked about and the pages an answer cites.
const pages = Object.fromEntries(
  (await getCollection("docs")).map((e) => [e.id === "index" ? "/docs" : `/docs/${e.id}`, e.data.title]),
);
// The Swirl loader from loading.dev (MIT): eight cells around an empty centre, lit in this order.
const ring = [0, 1, 2, 7, null, 3, 6, 5, 4];
---
<aside class="ask" id="ask" aria-label="Ask AI" hidden>
  <div class="ask-head">
    <span class="ask-title">Ask AI</span>
    <div class="ask-actions">
      <button class="ask-icon" type="button" data-ask-copy aria-label="Copy the conversation as Markdown">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      </button>
      <button class="ask-icon ask-wide-btn" type="button" data-ask-wide aria-label="Full screen" aria-pressed="false">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v3a2 2 0 0 1-2 2H3M21 8h-3a2 2 0 0 1-2-2V3M3 16h3a2 2 0 0 1 2 2v3M16 21v-3a2 2 0 0 1 2-2h3"/></svg>
      </button>
      <button class="ask-icon" type="button" data-ask-clear aria-label="Clear the conversation">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
      </button>
      <button class="ask-icon" type="button" data-ask-close aria-label="Close Ask AI">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m13 17 5-5-5-5M6 17l5-5-5-5"/></svg>
      </button>
    </div>
  </div>
  <div class="ask-log" role="log" aria-label="Conversation"></div>
  <div class="ask-empty">
    <div class="ask-starters"></div>
    <p class="ask-tip">Open and close with <kbd>⌘I</kbd></p>
  </div>
  <template id="ask-swirl">
    <span class="ask-swirl" aria-hidden="true">{ring.map((k) => (k === null ? <span /> : <i style={`--k:${k}`} />))}</span>
  </template>
  <div class="ask-dock">
    <div class="ask-attach" hidden>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/></svg>
      <span class="ask-attach-title"></span>
      <button class="ask-attach-x" type="button" aria-label="Remove this page from the question">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <form class="ask-form">
      <label class="sr" for="ask-input">Ask a question about egin</label>
      <textarea id="ask-input" rows="1" placeholder="Ask a question…" maxlength="2000"></textarea>
      <div class="ask-form-row">
        <button class="ask-send" type="submit" aria-label="Send" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
        </button>
        <button class="ask-stop" type="button" hidden>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><rect x="8.5" y="8.5" width="7" height="7" fill="currentColor" stroke="none"/></svg>
          Stop
        </button>
      </div>
    </form>
  </div>
  <p class="ask-foot">
    <span>Powered by</span>
    <svg class="ask-mark" width="34" height="11" viewBox="0 0 370 120" role="img" aria-label="egin"><path d="M0 0H90L76.2 20H0Z M0 50H76L62.2 70H0Z M0 100H76.2L90 120H0Z"/><path d="M110 0H210L196.2 20H110Z M110 50H130V100H190V80H160V60H210V120H110Z"/><path d="M230 0H250V120H230Z"/><path d="M270 0H290V120H270Z M350 0H370V120H350Z"/><path class="ask-mark-slash" d="M270 0H292L370 120H348Z"/></svg>
  </p>
  <script type="application/json" id="ask-pages" set:html={JSON.stringify(pages)} />
</aside>
<script is:inline>
  // Every page is a new document. The panel comes back as the page before left it: open, at the same
  // size, showing the same conversation. This runs while the page is parsed, so the first paint has the
  // panel and the transition between the two pages finds it in place on both sides. (The page's width for
  // a docked panel is set earlier still, in Page.astro's head.)
  (() => {
    let was = null;
    try { was = JSON.parse(sessionStorage.getItem("egin-ask-panel") ?? "null"); } catch {}
    if (!was) return;
    const panel = document.getElementById("ask");
    panel.hidden = false;
    if (was.log) {
      const log = panel.querySelector(".ask-log");
      log.innerHTML = was.log;
      log.scrollTop = was.top || 0;
      panel.querySelector(".ask-empty").hidden = true;
    }
  })();
</script>

<script>
  import { track } from "@vercel/analytics";
  import { Agent, type Message, type Snapshot } from "egin";
  import { transition } from "../lib/transition";

  type Page = { path: string; title: string };
  const panel = document.getElementById("ask")!;
  const log = panel.querySelector<HTMLElement>(".ask-log")!;
  const empty = panel.querySelector<HTMLElement>(".ask-empty")!;
  const starters = panel.querySelector<HTMLElement>(".ask-starters")!;
  const form = panel.querySelector<HTMLFormElement>(".ask-form")!;
  const input = panel.querySelector<HTMLTextAreaElement>("#ask-input")!;
  const send = panel.querySelector<HTMLButtonElement>(".ask-send")!;
  const stop = panel.querySelector<HTMLButtonElement>(".ask-stop")!;
  const attach = panel.querySelector<HTMLElement>(".ask-attach")!;
  const swirl = panel.querySelector<HTMLTemplateElement>("#ask-swirl")!;
  const titles: Record<string, string> = JSON.parse(document.getElementById("ask-pages")!.textContent!);
  const KEY = "egin-ask";
  const read = (k: string) => { try { return sessionStorage.getItem(k); } catch { return null; } };
  const write = (k: string, v: string | null) => { try { v === null ? sessionStorage.removeItem(k) : sessionStorage.setItem(k, v); } catch {} };
  // Votes on answers, by message id.
  let votes: Record<string, "up" | "down"> = {};
  try { votes = JSON.parse(read(`${KEY}-votes`) ?? "{}"); } catch {}

  // The conversation is egin's: `Agent` (the store `useAgent` wraps) follows the session through /egin, egin's
  // proxy on this site, and rebuilds the messages from its event stream. Only the session id is kept here.
  const agent = new Agent({ baseUrl: "/egin", sessionId: read(`${KEY}-id`), onSessionChange: (id) => write(`${KEY}-id`, id) });
  let snap: Snapshot = agent.getSnapshot();
  let started = false;
  let asked = ""; // the last question sent, to send again in a new session if egin lost the old one

  // A question carries the page the reader has open as a first line, which the bubble shows as a chip.
  const PAGE = /^\(I'm reading (\/[\w\-/]*)\.\)\n\n/;
  const texts = (parts: Message["parts"]) => parts.flatMap((p) => (p.type === "text" ? [p.text] : [])).join("");
  // An answer is the text after the agent's last tool call; text before it led into the call.
  const answerOf = (m: Message) => texts(m.parts.slice(m.parts.map((p) => p.type).lastIndexOf("tool") + 1)).trim();
  // workspace/docs/<page>.md is /docs/<page>; index.md is /docs.
  const pageUrl = (p: unknown) => {
    const m = String(p ?? "").match(/(?:^|\/)docs\/([\w-]+)\.md$/);
    return m ? (m[1] === "index" ? "/docs" : `/docs/${m[1]}`) : null;
  };
  const tools = (m: Message) => m.parts.flatMap((p) => (p.type === "tool" ? [p] : []));
  const sourcesOf = (m: Message) =>
    [...new Set(tools(m).flatMap((t) => (t.tool === "read_file" ? [pageUrl((t.args as { path?: string } | null)?.path)] : [])))].filter((p): p is string => !!p && !!titles[p]);

  // The docs page the reader is on goes with each question until they remove it.
  const here = (): Page | null => {
    const path = location.pathname.replace(/\/$/, "");
    return titles[path] ? { path, title: titles[path] } : null;
  };
  let detached = false;
  const attached = () => (detached ? null : here());

  // Markdown for answers, small on purpose: escape everything first, then add back only code, emphasis, lists
  // and links to egin pages or https URLs, so nothing the model writes can become markup.
  const escape = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const inline = (s: string) =>
    s
      .replace(/`([^`]+)`/g, "<code>$1</code>")
      .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
      .replace(/\[([^\]]+)\]\(((?:\/|https:\/\/)[^)\s]*)\)/g, (_, t, u) => `<a href="${u}"${u.startsWith("/") ? "" : ' target="_blank" rel="noreferrer"'}>${t}</a>`);
  const blocks = (text: string) =>
    text
      .split(/\n{2,}/)
      .map((b) => {
        const lines = b.split("\n");
        if (lines.every((l) => /^\s*[-*] /.test(l))) return `<ul>${lines.map((l) => `<li>${inline(l.replace(/^\s*[-*] /, ""))}</li>`).join("")}</ul>`;
        if (lines.every((l) => /^\s*\d+\. /.test(l))) return `<ol>${lines.map((l) => `<li>${inline(l.replace(/^\s*\d+\. /, ""))}</li>`).join("")}</ol>`;
        if (/^#{1,6} /.test(b)) return `<p><strong>${inline(b.replace(/^#{1,6} /, ""))}</strong></p>`;
        return b.trim() ? `<p>${inline(b).replace(/\n/g, "<br>")}</p>` : "";
      })
      .join("");
  // Code blocks go through @pierre/highlights, the same highlighter and themes as the docs pages. Its
  // WebAssembly (about 300 KB) loads the first time an answer has a code block; until then code shows plain.
  type Hl = { h: typeof import("@pierre/highlights"); t: typeof import("@pierre/highlights/themes") };
  let hl: Hl | null = null;
  let loading: Promise<void> | null = null;
  const decoder = new TextDecoder();
  const code = (text: string, lang: string) => {
    text = text.replace(/\n$/, "");
    if (!hl) {
      loading ||= Promise.all([import("@pierre/highlights"), import("@pierre/highlights/themes")])
        .then(([h, t]) => { hl = { h, t }; render(); })
        .catch(() => {});
      return `<pre><code>${escape(text)}</code></pre>`;
    }
    const { h, t } = hl;
    // The lexer escapes the code itself; the bytes are a view into WebAssembly memory, so decode them now.
    return decoder.decode(h.codeToHtml(text, {
      lang: h.isSupportedLanguage(lang) ? lang : "text",
      themes: { light: t.pierreLight, dark: t.pierreDark },
      defaultColor: "light-dark()",
    }));
  };
  const markdown = (src: string) => {
    const out: string[] = [];
    let at = 0;
    for (const m of src.matchAll(/```([\w-]*)\n([\s\S]*?)(?:```|$)/g)) {
      out.push(blocks(escape(src.slice(at, m.index))), code(m[2], m[1]));
      at = m.index! + m[0].length;
    }
    out.push(blocks(escape(src.slice(at))));
    return out.join("");
  };

  const ICON = {
    copy: '<rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
    check: '<path d="M20 6 9 17l-5-5"/>',
    up: '<path d="M7 10v11M15 5.9 14 10h5.8a2 2 0 0 1 2 2.3l-1.4 7A2 2 0 0 1 18.4 21H4a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1h2.8a2 2 0 0 0 1.8-1.1L12 2a3.1 3.1 0 0 1 3 3.9Z"/>',
    down: '<path d="M17 14V3M9 18.1 10 14H4.2a2 2 0 0 1-2-2.3l1.4-7A2 2 0 0 1 5.6 3H20a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-2.8a2 2 0 0 0-1.8 1.1L12 22a3.1 3.1 0 0 1-3-3.9Z"/>',
    book: '<path d="M19 21 12 17 5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>',
    file: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/>',
    chevron: '<path d="m6 9 6 6 6-6"/>',
  };
  const icon = (name: keyof typeof ICON, size = 14) =>
    `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[name]}</svg>`;
  const make = <K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, html = "") => {
    const el = document.createElement(tag);
    el.className = cls;
    if (html) el.innerHTML = html;
    return el;
  };

  const actionBtn = (label: string, name: keyof typeof ICON, onClick: (b: HTMLButtonElement) => void) => {
    const b = make("button", "ask-icon ask-act", icon(name));
    b.type = "button";
    b.setAttribute("aria-label", label);
    b.title = label;
    b.addEventListener("click", () => onClick(b));
    return b;
  };

  const view = (m: Message, live: boolean) => {
    const el = make("div", `ask-turn ${m.role}`);
    el.dataset.id = m.id;
    if (m.role === "user") {
      const text = texts(m.parts);
      const page = text.match(PAGE)?.[1];
      const bubble = make("div", "ask-bubble");
      bubble.textContent = text.replace(PAGE, "");
      el.append(bubble);
      if (page) {
        const chip = make("span", "ask-chip", icon("file", 12));
        chip.title = page;
        const t = make("span", "ask-chip-title");
        t.textContent = titles[page] ?? page;
        chip.append(Object.assign(make("span", "sr"), { textContent: "Asked about " }), t);
        el.append(chip);
      }
      return el;
    }
    const content = answerOf(m);
    const sources = sourcesOf(m);
    if (live && !content) {
      const status = make("p", "ask-status");
      const last = tools(m).at(-1);
      const reading = last?.tool === "read_file" ? pageUrl((last.args as { path?: string } | null)?.path) : null;
      status.append(
        swirl.content.cloneNode(true),
        reading ? ` Reading ${titles[reading] ?? reading}…` : last?.tool === "search_files" ? " Searching the docs…" : " Thinking…",
      );
      el.append(status);
      return el;
    }
    if (sources.length) {
      const details = make("details", "ask-sources");
      details.innerHTML = `<summary>${icon("book")}<span>Used ${sources.length} source${sources.length === 1 ? "" : "s"}</span>${icon("chevron", 12)}</summary>`;
      const list = make("ul", "");
      for (const p of sources) {
        const a = make("a", "");
        a.href = p;
        a.textContent = titles[p];
        const li = make("li", "");
        li.append(a);
        list.append(li);
      }
      details.append(list);
      el.append(details);
    }
    el.append(make("div", "ask-md", markdown(content)));
    if (live || !content) return el;

    const vote = votes[m.id];
    const row = make("div", "ask-row");
    row.append(
      actionBtn("Copy response as Markdown", "copy", async (b) => {
        try { await navigator.clipboard.writeText(content); } catch { return; }
        b.innerHTML = icon("check");
        b.setAttribute("aria-label", "Response copied");
        setTimeout(() => { b.innerHTML = icon("copy"); b.setAttribute("aria-label", "Copy response as Markdown"); }, 2000);
      }),
    );
    for (const [v, label] of [["up", "Helpful"], ["down", "Not helpful"]] as const) {
      const b = actionBtn(label, v, () => {
        if (votes[m.id]) return;
        votes[m.id] = v;
        write(`${KEY}-votes`, JSON.stringify(votes));
        track("ask_feedback", { vote: v, page: location.pathname });
        el.replaceWith(view(m, false));
      });
      b.setAttribute("aria-pressed", String(vote === v));
      b.disabled = !!vote;
      row.append(b);
    }
    if (vote) row.append(Object.assign(make("span", "ask-thanks"), { textContent: "Thanks for the feedback", role: "status" }));
    el.append(row);
    return el;
  };

  const copyBtn = panel.querySelector<HTMLButtonElement>("[data-ask-copy]")!;
  const clearBtn = panel.querySelector<HTMLButtonElement>("[data-ask-clear]")!;
  // A conversation the page before was showing is on screen already (see the inline script above). It
  // stays until the saved session has been replayed, so the panel is not emptied and filled again.
  let shown = !panel.hidden && log.childElementCount > 0 && !!read(`${KEY}-id`);
  // The page being read, offered with the next question.
  const chip = () => {
    const page = attached();
    attach.hidden = !page;
    attach.querySelector(".ask-attach-title")!.textContent = page?.title ?? "";
  };
  const render = () => {
    if (shown) return chip();
    const ms = snap.messages;
    const busy = snap.status !== "idle";
    const nodes = ms.map((m, i) => view(m, busy && i === ms.length - 1 && m.role === "assistant"));
    // Between the question and the first event, the answer is still to come.
    if (busy && ms.at(-1)?.role !== "assistant") nodes.push(view({ id: "pending", role: "assistant", parts: [] }, true));
    // A 404 is a saved conversation the server no longer has: the connection is fine, and the next
    // question starts a new one.
    const failed = /\b404\b/.test(snap.error ?? "") ? "That conversation is no longer available. Ask again to start a new one." : "Couldn't reach Ask AI. Check your connection and try again.";
    if (snap.error && !busy) nodes.push(Object.assign(make("p", "ask-error"), { textContent: failed, role: "alert" }));
    // Keep open source lists open, and follow the answer only while the reader is at the bottom.
    const open = new Set([...log.querySelectorAll<HTMLElement>("details[open]")].map((d) => d.closest<HTMLElement>(".ask-turn")?.dataset.id));
    const stick = log.scrollHeight - log.scrollTop - log.clientHeight < 80;
    log.replaceChildren(...nodes);
    for (const d of log.querySelectorAll<HTMLDetailsElement>("details")) if (open.has(d.closest<HTMLElement>(".ask-turn")?.dataset.id)) d.open = true;
    if (stick) log.scrollTop = log.scrollHeight;
    log.setAttribute("aria-busy", String(busy));
    empty.hidden = ms.length > 0 || busy;
    copyBtn.disabled = clearBtn.disabled = ms.length === 0;
    send.hidden = busy;
    stop.hidden = !busy;
    chip();
  };
  let frame = 0;
  agent.subscribe(() => {
    snap = agent.getSnapshot();
    // Replayed: its messages are here, or it turned out to be gone.
    if (snap.messages.length || snap.error) shown = false;
    // egin no longer has the session (another warm instance held it, or it restarted): go on in a new one.
    if (snap.error && /\b404\b/.test(snap.error) && snap.sessionId) {
      agent.newSession();
      if (asked) void agent.send(asked);
      return;
    }
    frame ||= requestAnimationFrame(() => { frame = 0; render(); });
  });
  attach.querySelector(".ask-attach-x")!.addEventListener("click", () => {
    detached = true;
    render();
    questions();
    input.focus();
  });
  copyBtn.addEventListener("click", async () => {
    const md = snap.messages.map((m) => (m.role === "user" ? `**You:** ${texts(m.parts).replace(PAGE, "")}` : answerOf(m))).join("\n\n");
    try {
      await navigator.clipboard.writeText(md);
      copyBtn.setAttribute("aria-label", "Copied");
      setTimeout(() => copyBtn.setAttribute("aria-label", "Copy the conversation as Markdown"), 1500);
    } catch {}
  });
  // Expanded: the panel covers the window, for long answers and code.
  const wideBtn = panel.querySelector<HTMLButtonElement>("[data-ask-wide]")!;
  wideBtn.addEventListener("click", () =>
    // The panel grows out of its docked place, or back into it.
    transition("panel resize", () => {
      wideBtn.setAttribute("aria-pressed", String(document.documentElement.classList.toggle("ask-wide")));
      cover();
    }),
  );
  // The page under a panel as wide as the window (expanded, or on a phone) can't be seen, so it
  // takes no focus either.
  function cover() {
    const on = !panel.hidden && panel.offsetWidth >= innerWidth;
    for (const el of document.body.children) if (!el.contains(panel)) el.toggleAttribute("inert", on);
  }

  const questions = () => {
    const list = [
      ...(attached() ? ["Summarize this page"] : []),
      "How do I create my first agent?",
      "What goes in the agent folder?",
      "How do I add a tool?",
      "How do I serve an agent over HTTP?",
    ].slice(0, 4);
    starters.replaceChildren(
      ...list.map((q) => {
        const b = make("button", "ask-starter");
        b.type = "button";
        b.textContent = q;
        b.addEventListener("click", () => ask(q));
        return b;
      }),
    );
  };

  // The box grows with the question, from two lines to about eight, then scrolls.
  const ready = () => {
    send.disabled = !input.value.trim();
    input.style.height = "56px";
    input.style.height = `${Math.min(Math.max(input.scrollHeight, 56), 200)}px`;
  };
  form.addEventListener("click", (e) => { if (e.target === form) input.focus(); });

  function ask(question: string) {
    const q = question.trim();
    if (!q || snap.status !== "idle") return;
    const page = attached();
    asked = page ? `(I'm reading ${page.path}.)\n\n${q}` : q;
    input.value = "";
    ready();
    void agent.send(asked);
  }

  // The shortcut reads ⌘I on Apple keyboards and Ctrl I elsewhere.
  if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll(".ask-key").forEach((k) => (k.textContent = "Ctrl I"));
    const tip = panel.querySelector(".ask-tip kbd");
    if (tip) tip.textContent = "Ctrl I";
  }

  const root = document.documentElement;
  const open = (focus = true) => {
    panel.hidden = false;
    root.classList.add("ask-open");
    // Replays a saved conversation from egin and follows a turn still running.
    if (!started) { started = true; agent.start(); }
    questions();
    render();
    cover();
    if (focus) input.focus();
  };
  const close = () => {
    panel.hidden = true;
    root.classList.remove("ask-open");
    cover();
  };
  // The page before left the panel open, and it is on screen already: carry on from there, without moving
  // focus into it. Leaving this page saves the same things for the next one.
  if (!panel.hidden) {
    wideBtn.setAttribute("aria-pressed", String(root.classList.contains("ask-wide")));
    open(false);
  }
  addEventListener("pagehide", () => {
    const html = log.innerHTML;
    write(`${KEY}-panel`, panel.hidden ? null : JSON.stringify({ wide: root.classList.contains("ask-wide"), log: snap.messages.length && html.length < 200_000 ? html : "", top: log.scrollTop }));
  });
  // Opened and closed by a person, the panel comes in from its edge and leaves the same way.
  const toggle = () => transition("panel", () => (panel.hidden ? open() : close()));

  document.addEventListener("click", (e) => {
    if ((e.target as Element).closest("[data-ask-open]")) {
      e.preventDefault();
      if (panel.hidden) transition("panel", () => open());
      else input.focus();
    }
  });
  panel.querySelector("[data-ask-close]")!.addEventListener("click", () => transition("panel", close));
  clearBtn.addEventListener("click", () => {
    void agent.cancel();
    agent.newSession();
    votes = {};
    write(`${KEY}-votes`, null);
    input.focus();
  });
  stop.addEventListener("click", () => void agent.cancel());
  input.addEventListener("input", ready);
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    ask(input.value);
  });
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
      e.preventDefault();
      ask(input.value);
    }
  });
  addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && !e.altKey && e.key.toLowerCase() === "i") {
      e.preventDefault();
      toggle();
    } else if (e.key === "Escape" && !panel.hidden && panel.contains(document.activeElement)) {
      transition("panel", close);
    }
  });
</script>

<!-- Global: the starters and messages are made in script, so Astro's scoped attribute never reaches them.
