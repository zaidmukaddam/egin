---
import { getCollection } from "astro:content";
import Article from "../../layouts/Article.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const day = new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" });
---
<Article title="Blog · egin" description="Releases, benchmarks and notes from building egin.">
  <h1>Blog</h1>
  <p class="lede">Releases, benchmarks and notes from building egin.</p>
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.id}`}>
          <time datetime={p.data.date.toISOString().slice(0, 10)}>{day.format(p.data.date)}</time>
          <strong>{p.data.title}</strong>
          <span>{p.data.description}</span>
        </a>
      </li>
    ))}
  </ul>
  <style>
    .lede { color: var(--muted); margin-bottom: 40px; }
    .posts { list-style: none; margin: 0; padding: 0; }
    .posts a { display: flex; flex-direction: column; gap: 4px; margin: 0 -16px; padding: 16px; border-radius: 12px; transition: background-color 150ms; }
    @media (hover: hover) { .posts a:hover { background: rgb(var(--tint) / 0.04); } }
    .posts time { font: 0.8125rem/1.5 var(--mono); color: var(--dim); }
    .posts strong { font-size: 1.125rem; line-height: 1.4; font-weight: 550; color: var(--fg); text-wrap: balance; }
    .posts span { font-size: 0.9375rem; line-height: 1.5; color: var(--muted); text-wrap: pretty; }
  </style>
</Article>
