      addEventListener("resize", () => { draw(); spy(); });
      document.fonts?.ready.then(draw);
      draw();
      spy();
      // Picking a section on a narrow screen folds the list away again.
      onpage?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => (onpage.open = false)));

      // Contents links (rail and popover) glide to their section: an eased scroll driven here rather than the
      // browser's own smooth scroll, which some browsers skip for long jumps. Reduced motion jumps straight there.
      let gliding = 0;
      const glide = (to: number) => {
        cancelAnimationFrame(gliding);
        const from = scrollY, dist = to - from;
        const ms = Math.min(700, 300 + Math.abs(dist) / 20);
        const t0 = performance.now();
        const ease = (t: number) => 1 - Math.pow(1 - t, 3);
        const step = (now: number) => {
          const t = Math.min(1, (now - t0) / ms);
          scrollTo({ top: from + dist * ease(t), behavior: "instant" });
          if (t < 1) gliding = requestAnimationFrame(step);
        };
        gliding = requestAnimationFrame(step);
      };
      document.querySelectorAll<HTMLAnchorElement>(".rail nav a, .onpage nav a").forEach((a) =>
        a.addEventListener("click", (e) => {
          const target = document.getElementById(decodeURIComponent(a.hash.slice(1)));
          if (!target) return;
          e.preventDefault();
          history.pushState(null, "", a.hash);
          const top = target.getBoundingClientRect().top + scrollY - parseFloat(getComputedStyle(target).scrollMarginTop || "0");
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) scrollTo({ top, behavior: "instant" });
          else glide(Math.max(0, Math.min(top, document.documentElement.scrollHeight - innerHeight)));
          target.focus?.({ preventScroll: true });
        }),
      );
    }

    // A copy button on each code block. The wrapper only positions it, so nothing moves.
    const prose = document.querySelector<HTMLElement>(".prose")!;
    prose.querySelectorAll("pre").forEach((pre) => {
      const wrap = document.createElement("div");
      wrap.className = "code";
      const b = document.createElement("button");
      b.className = "copy";
      b.setAttribute("aria-label", "Copy code");
      b.dataset.copy = pre.textContent ?? "";
      b.innerHTML = prose.dataset.copyIcon!;
      pre.replaceWith(wrap);
      wrap.append(pre, b);
    });
  </script>

  <style>
