    .onpage[open] summary { color: var(--fg); }
    .onpage nav { position: absolute; top: calc(100% + 6px); right: 0; z-index: 25; display: flex; flex-direction: column; width: min(260px, calc(100vw - 48px)); max-height: min(60vh, 420px); overflow-y: auto; padding: 10px 6px 6px; border-radius: 12px; background: var(--raise); box-shadow: 0 0 0 1px var(--ring), 0 12px 32px rgb(0 0 0 / 0.3); transform-origin: top right; transition: opacity 150ms var(--ease-out), scale 150ms var(--ease-out); }
